// Final HDR/EDR display color-management pass, cross-compiled via sokol-shdc. See app-colorpass.cpp for how
// the compiled output is loaded and its uniforms set.
//
// Only built for the desktop OpenGL backend (glsl410): macOS EDR consumes extended sRGB directly, and the
// HDR-enabling GLFW fork is excluded on Emscripten.

@vs vs
in vec2 position;
out vec2 uv;

void main()
{
    uv          = position * 0.5 + 0.5;
    gl_Position = vec4(position, 0.0, 1.0);
}
@end

@fs fs
// color math shared with C++; see src/shared/shim.h
@include ../../src/shared/shim.h
@include ../../src/shared/colorspace.h
@include ../../src/shared/dither.h

layout(binding=0) uniform colorpass_params {
    int   tf_type;        // TransferFunction::Type_ the display wants
    float tf_gamma;       // the exponent, when tf_type == TF_GAMMA
    float tf_white_nits;  // reference white of tf_type itself, in nits (HLG: the peak its EOTF assumes; PQ: 0.0)
    float sdr_white_nits; // display's configured SDR reference white, in nits
    float min_nits;       // display's reported minimum luminance, in nits (0.0 == unknown)
    float max_nits;       // display's reported maximum luminance, in nits (0.0 == unknown)
    mat3  gamut_matrix;   // Rec.709 -> display primaries; identity when they already match
    float dither_step;    // the step the encoded output is dithered by, or 0 for none
    vec2  randomness;     // a per-frame offset into the dither texture
} cpp;

layout(binding=0) uniform texture2D color_texture;
layout(binding=0) uniform sampler   color_sampler;
layout(binding=1) uniform texture2D dither_texture;
layout(binding=1) uniform sampler   dither_sampler;

in vec2 uv;

out vec4 frag_color;

void main()
{
    vec4 color = texture(sampler2D(color_texture, color_sampler), uv);

    // decode HDRView's extended-sRGB convention (1.0 == sdr_white_nits) to absolute nits, preserving the
    // sign of out-of-gamut colors, then move to the display's primaries
    vec3 nits = cpp.gamut_matrix * (cpp.sdr_white_nits * sRGB_to_linear(color.rgb));

    // Some displays tonemap out-of-range values, so hard-clip to their own reported limits instead, as
    // nanogui-1's ColorPass does. 0.0 means "unknown", not "no limit", so only clamp when one is reported.
    if (cpp.max_nits > 0.0)
        nits = clamp(nits, vec3(cpp.min_nits), vec3(cpp.max_nits));

    vec3 encoded;
    if (cpp.tf_type == TF_BT2100_PQ)
        // PQ is absolute: it consumes nits directly and does its own normalization, so do not divide by
        // tf_white_nits first (see inverse_EOTF_BT2100_PQ() in src/shared/colorspace.h). It has no negative
        // representation, so luminance below zero is clipped.
        encoded = inverse_EOTF_BT2100_PQ(max(nits, vec3(0.0)));
    else if (cpp.tf_type == TF_BT2100_HLG)
        // HLG is display-referred here too: its EOTF depends on the peak it renders to, which tf_white_nits
        // holds, and it has no negative representation either
        encoded = inverse_EOTF_BT2100_HLG(max(nits, vec3(0.0)), 0.0, cpp.tf_white_nits);
    else
        // everything else is defined relative to a reference white. wp_color_manager_v1's ext_srgb shares
        // sRGB's curve, which from_linear() sign-extends; a transfer it does not know is left linear.
        encoded = from_linear(nits / cpp.tf_white_nits, cpp.tf_type, cpp.tf_gamma);

    // dithered in the display's own encoding, as the image shader dithers its own output; see display_dither()
    if (cpp.dither_step > 0.0)
    {
        float rank = texture(sampler2D(dither_texture, dither_sampler), (gl_FragCoord.xy + cpp.randomness) / 256.0).r;
        encoded += vec3(2.0 * tent_from_box(box_from_rank(rank * 255.0)) * cpp.dither_step);
    }

    frag_color = vec4(encoded, color.a);
}
@end

@program colorpass vs fs
