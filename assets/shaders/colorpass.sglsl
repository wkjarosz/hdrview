// Final HDR/EDR display color-management pass, written once and cross-compiled via sokol-shdc. See
// SokolShaderCompiler.cmake and CMakeLists.txt for the CMake wiring, and app-colorpass.cpp's update_colorpass()/
// end_colorpass_frame() for how the compiled output is loaded and its uniforms set.
//
// Only ever built for the desktop OpenGL backend (glsl410) -- never Metal (macOS EDR consumes HDRView's
// extended-sRGB shader output directly, no colorpass needed) and never Emscripten (the whole HDR-enabling
// GLFW fork is excluded there). See CMakeLists.txt's sokol_shdc_generate() call for this file.

@include colorspaces.sglsl

@block colorpass_constants
// Mirrors TransferFunction::Type_ in src/colorspace.h -- the display's wanted transfer function arrives here
// already translated out of wp_color_manager_v1's numbering by query_display_colorspace()
// (src/display_colorspace.cpp), so no Wayland protocol code points appear in this shader.
#define TF_LINEAR       1
#define TF_GAMMA        2
#define TF_SRGB         3
#define TF_ITU          4
#define TF_BT2100_PQ    5
#define TF_IEC61966_2_4 10
@end

@vs vs
in vec2 position;
out vec2 uv;

void main()
{
    uv          = position * 0.5 + 0.5;
    gl_Position = vec4(position, 0.0, 1.0);
}
@end

@fs fs
@include_block colorpass_constants
@include_block colorspaces
@include_block hdr_transfer

layout(binding=0) uniform colorpass_params {
    int   tf_type;        // TransferFunction::Type_ the display wants
    float tf_gamma;       // the exponent, when tf_type == TF_GAMMA
    float tf_white_nits;  // reference white of tf_type itself, in nits; 0.0 for absolute transfers (PQ)
    float sdr_white_nits; // display's configured SDR reference white, in nits
    float min_nits;       // display's reported minimum luminance, in nits (0.0 == unknown)
    float max_nits;       // display's reported maximum luminance, in nits (0.0 == unknown)
    mat3  gamut_matrix;   // Rec.709 -> display primaries; identity when they already match
} cpp;

layout(binding=0) uniform texture2D color_texture;
layout(binding=0) uniform sampler   color_sampler;

in vec2 uv;

out vec4 frag_color;

void main()
{
    vec4 color = texture(sampler2D(color_texture, color_sampler), uv);

    // Decode HDRView's extended-sRGB convention (1.0 == sdr_white_nits) to absolute nits, sign preserved
    // (out-of-gamut colors are genuinely negative), then move to the display's primaries.
    vec3 nits = cpp.gamut_matrix * (cpp.sdr_white_nits * sRGBToLinear(color.rgb));

    // Some displays perform unwanted tonemapping on out-of-range values; hard-clip to the display's own
    // reported luminance limits instead, matching nanogui-1's ColorPass. 0.0 means "unknown", not "no
    // limit" -- only clamp when a limit is actually reported.
    if (cpp.max_nits > 0.0)
        nits = clamp(nits, vec3(cpp.min_nits), vec3(cpp.max_nits));

    vec3 encoded;
    if (cpp.tf_type == TF_BT2100_PQ)
        // PQ is absolute: it consumes nits directly and does its own normalization. Do not divide by
        // tf_white_nits first -- see the note on pq_encode() in colorspaces.sglsl.
        encoded = pq_encode(nits);
    else
    {
        // Everything below is defined relative to a reference white.
        vec3 relative = nits / cpp.tf_white_nits;
        if (cpp.tf_type == TF_GAMMA)
            encoded = gamma_encode(relative, cpp.tf_gamma);
        else if (cpp.tf_type == TF_SRGB)
            // Also covers wp_color_manager_v1's ext_srgb, which shares the curve and which our sRGB
            // encoders sign-extend. Reachable on Windows with advanced color on but only 8 bits/channel.
            encoded = linearToSRGB(relative);
        else if (cpp.tf_type == TF_ITU || cpp.tf_type == TF_IEC61966_2_4)
            encoded = itu_encode(relative);
        else // TF_LINEAR, or a transfer we don't implement -- scRGB-style linear is the safest fallback
            encoded = relative;
    }

    frag_color = vec4(encoded, color.a);
}
@end

@program colorpass vs fs
