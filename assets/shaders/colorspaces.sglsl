// Shared colorspace math, written once and cross-compiled to GLSL/GLES/Metal via sokol-shdc.
// This is a @block, not a standalone program: it only produces output once @include_block'd into
// a @vs/@fs section of a real @program (see image-shader.sglsl). See SokolShaderCompiler.cmake
// and CMakeLists.txt for the CMake wiring.
@block colorspaces

// Luminance-chroma to RGB conversion
// assumes `input: {RY, Y, BY}`
vec3 YC_to_RGB(vec3 c, vec3 Yw)
{
    if (c[0] == 0.0 && c[2] == 0.0)
        //
        // Special case -- both chroma channels are 0.  To avoid
        // rounding errors, we explicitly set the output R, G and B
        // channels equal to the input luminance.
        //
        return vec3(c.g, c.g, c.g);

    float Y = c.g;
    float r = (c.r + 1.0) * c.g;
    float b = (c.b + 1.0) * c.g;
    float g = (Y - r * Yw.x - b * Yw.z) / Yw.y;

    return vec3(r, g, b);
}

float linearToS(float a)
{
    float old_sign = sign(a);
    a              = abs(a);
    // The whole curve must be sign-extended, so the -0.055 offset has to be inside the multiplication by
    // old_sign, not outside it. Extended sRGB carries genuinely negative (out-of-gamut) values, and the
    // colorpass decodes what this encodes -- getting the sign wrong here breaks that round-trip.
    return a < 0.0031308 ? old_sign * 12.92 * a : old_sign * (1.055 * pow(a, 1.0 / 2.4) - 0.055);
}

vec3 linearToSRGB(vec3 color) { return vec3(linearToS(color.r), linearToS(color.g), linearToS(color.b)); }
vec4 linearToSRGB(vec4 color) { return vec4(linearToSRGB(color.rgb), color.a); }

float sToLinear(float a)
{
    float old_sign = sign(a);
    a              = abs(a);
    return a < 0.04045 ? old_sign * (1.0 / 12.92) * a : old_sign * pow((a + 0.055) * (1.0 / 1.055), 2.4);
}

vec3 sRGBToLinear(vec3 color) { return vec3(sToLinear(color.r), sToLinear(color.g), sToLinear(color.b)); }
vec4 sRGBToLinear(vec4 color) { return vec4(sRGBToLinear(color.rgb), color.a); }

// returns the luminance of a linear rgb color
float RGBToY(vec3 rgb, vec3 weights) { return dot(weights, rgb); }

// Converts a color from linear RGB to XYZ space
vec3 RGBToXYZ(vec3 rgb)
{
    const mat3 RGB2XYZ = mat3(0.412453, 0.212671, 0.019334, 0.357580, 0.715160, 0.119193, 0.180423, 0.072169, 0.950227);
    return RGB2XYZ * rgb;
}

// Converts a color from XYZ to linear RGB space
vec3 XYZToRGB(vec3 xyz)
{
    const mat3 XYZ2RGB =
        mat3(3.240479, -0.969256, 0.055648, -1.537150, 1.875992, -0.204043, -0.498535, 0.041556, 1.057311);
    return XYZ2RGB * xyz;
}

@end

// HDR display-transfer encoders, shared by the colorpass (see colorpass.sglsl) -- kept separate from the
// @block above so image-shader.sglsl, which doesn't need them, doesn't pull them in.
@block hdr_transfer

// Recommendation ITU-R BT.2100-2 PQ inverse EOTF. PQ is an *absolute* transfer function: it maps luminance
// in nits straight to a code value, so unlike the encoders below it takes absolute nits and does its own
// 10000-nit normalization rather than a caller-supplied reference white. PQ has no negative representation,
// so clip below zero.
//
// The five constants below are the decimal expansions of the exact rationals in inverse_EOTF_BT2100_PQ() in
// src/colorspace.h. Nothing in the build enforces that -- tests/test_colorspace.cpp does, in
// "colorpass GLSL PQ constants match colorspace.h's inverse_EOTF_BT2100_PQ", which also pins the fact that
// this function takes absolute nits while colorspace.h's from_linear() applies a 219x broadcast scaling
// first. Edit both sides together.
float pq_encode(float nits)
{
    const float m1  = 0.1593017578125; // 2610 / 16384
    const float m2  = 78.84375;        // 2523 * 128 / 4096
    const float c1  = 0.8359375;       // 3424 / 4096
    const float c2  = 18.8515625;      // 2413 * 32 / 4096
    const float c3  = 18.6875;         // 2392 * 32 / 4096
    float       Y   = max(nits, 0.0) / 10000.0;
    float       Ym1 = pow(Y, m1);
    return pow((c1 + c2 * Ym1) / (1.0 + c3 * Ym1), m2);
}
vec3 pq_encode(vec3 nits) { return vec3(pq_encode(nits.r), pq_encode(nits.g), pq_encode(nits.b)); }

// A literal power curve (not the piecewise sRGB OETF above), sign-extended so out-of-gamut (negative)
// values survive the pass. Takes a value already normalized by the transfer function's reference white.
vec3 gamma_encode(vec3 relative, float gamma) { return sign(relative) * pow(abs(relative), vec3(1.0 / gamma)); }

// The ITU-T BT.601/BT.709/BT.2020 OETF, sign-extended. Mirrors OETF_ITU() in src/colorspace.h; sign-extended
// it is also exactly IEC 61966-2-4 (xvYCC), which colorspace.h defines as copysign(OETF_ITU(abs(x)), x).
float itu_encode(float relative)
{
    const float alpha = 1.09929682680944;
    const float beta  = 0.018053968510807;
    float       s     = sign(relative);
    float       a     = abs(relative);
    return a < beta ? s * 4.5 * a : s * (alpha * pow(a, 0.45) - (alpha - 1.0));
}
vec3 itu_encode(vec3 relative)
{
    return vec3(itu_encode(relative.r), itu_encode(relative.g), itu_encode(relative.b));
}

@end
