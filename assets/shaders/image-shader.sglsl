// Main image-view vertex+fragment shader, written once and cross-compiled to GLSL/GLES/Metal via sokol-shdc.
// See SokolShaderCompiler.cmake and CMakeLists.txt for the CMake wiring, and app-draw.cpp for how the
// compiled output is loaded and its uniforms set.
//
// GLSL uniform blocks cannot contain `bool` members (glslang rejects it), so booleans below are `int`
// (0/1); C++ call sites pass 0/1 and shader code compares with `!= 0`.

@vs vs
layout(binding=0) uniform vs_params {
    vec2 primary_scale;
    vec2 primary_pos;
    vec2 secondary_scale;
    vec2 secondary_pos;
    // Padding. With only vec2 members SPIRV-Cross's glsl300es output flattens this block to
    // `uniform vec4 vs_params[2]`, losing the member names set_buffer("vsp.*", ...) needs; one int keeps it a
    // struct, as fs_params below already is by virtue of its mixed member types.
    int _pad;
} vsp;

in vec2 position;

out vec2 primary_uv;
out vec2 secondary_uv;

void main()
{
    primary_uv   = (position / 2.0 - vsp.primary_pos + 0.5) / vsp.primary_scale;
    secondary_uv = (position / 2.0 - vsp.secondary_pos + 0.5) / vsp.secondary_scale;
    gl_Position  = vec4(position.x, -position.y, 0.0, 1.0);
}
@end

@fs fs
// constants and per-pixel math shared with C++; see src/shared/shim.h
@include ../../src/shared/shim.h
@include ../../src/shared/constants.h
@include ../../src/shared/colorspace.h
@include ../../src/shared/pipeline.h
@include ../../src/shared/edits.h
@include ../../src/shared/envmap.h

layout(binding=1) uniform fs_params {
    int   has_reference;
    int   do_dither;
    vec2  randomness;
    int   blend_mode;
    int   channel;
    float gain;
    float offset;
    float gamma;
    int   tonemap_mode;
    int   clamp_to_LDR;
    int   rolloff;
    float rolloff_preserve_hue;
    float rolloff_ceiling;
    int   rolloff_has_peak;
    float rolloff_peak;
    int   bg_mode;
    vec4  bg_color;
    int   reverse_colormap;
    vec3  primary_yw;
    int   primary_luminance_chroma;
    mat4  primary_M_to_sRGB;
    vec3  secondary_yw;
    int   secondary_luminance_chroma;
    mat4  secondary_M_to_sRGB;
    float time;
    ivec2 clip_warnings;
    vec2  clip_range;
    int   primary_straight_alpha;
    int   secondary_straight_alpha;
    // an edit dialog's preview of the current image; see EditPreview in src/app.h
    int   edit_op;
    ivec4 edit_slots;
    int   edit_color;
    vec4  edit_rect;
    vec4  edit_p0;
    vec4  edit_p1;
    mat4  edit_m0;
    mat4  edit_m1;
    // a remap dialog's preview, which reads the current image as remap_src and shows it as remap_dst
    int   remap;
    int   remap_src;
    int   remap_dst;
} fsp;

layout(binding=0) uniform texture2D colormap;
layout(binding=0) uniform sampler   colormap_sampler;

layout(binding=1) uniform texture2D dither_texture;
layout(binding=1) uniform sampler   dither_sampler;

layout(binding=2) uniform texture2D primary_0_texture;
layout(binding=3) uniform texture2D primary_1_texture;
layout(binding=4) uniform texture2D primary_2_texture;
layout(binding=5) uniform texture2D primary_3_texture;
layout(binding=2) uniform sampler   primary_0_sampler;
layout(binding=3) uniform sampler   primary_1_sampler;
layout(binding=4) uniform sampler   primary_2_sampler;
layout(binding=5) uniform sampler   primary_3_sampler;

layout(binding=6) uniform texture2D secondary_0_texture;
layout(binding=7) uniform texture2D secondary_1_texture;
layout(binding=8) uniform texture2D secondary_2_texture;
layout(binding=9) uniform texture2D secondary_3_texture;
layout(binding=6) uniform sampler   secondary_0_sampler;
layout(binding=7) uniform sampler   secondary_1_sampler;
layout(binding=8) uniform sampler   secondary_2_sampler;
layout(binding=9) uniform sampler   secondary_3_sampler;

in vec2 primary_uv;
in vec2 secondary_uv;

out vec4 frag_color;

// The tonemap step with the colormap read from its texture; the rest is tonemap() in src/shared/pipeline.h.
vec4 apply_tonemap(vec4 color)
{
    vec3 colormap_sRGB = vec3(0.0);
    if (fsp.tonemap_mode != Tonemap_Gamma)
    {
        // texel centers, so that 0 and 1 land on the colormap's first and last colors
        float n = float(textureSize(sampler2D(colormap, colormap_sampler), 0).x);
        float t = mix(0.5 / n, (n - 0.5) / n, colormap_coordinate(color.rgb, fsp.tonemap_mode, fsp.reverse_colormap != 0));
        colormap_sRGB = texture(sampler2D(colormap, colormap_sampler), vec2(t, 0.5)).rgb;
    }
    return tonemap(color, fsp.tonemap_mode, fsp.gamma, colormap_sRGB);
}

float rand_box(vec2 xy)
{
    // Result is in range (-0.5, 0.5)
    return (texture(sampler2D(dither_texture, dither_sampler), xy / vec2(256, 256)).r + 0.5) / 65536.0 - 0.5;
}

float rand_tent(vec2 xy)
{
    float r = rand_box(xy);

    // Convert uniform distribution into triangle-shaped distribution
    // Result is in range (-0.5,0.5)
    float rp = sqrt(2.0 * r);             // positive triangle
    float rn = sqrt(2.0 * r + 1.0) - 1.0; // negative triangle
    return (r < 0.0) ? 0.5 * rn : 0.5 * rp;
}

vec4 dither(vec4 color)
{
    if (fsp.do_dither == 0)
        return color;

    return color + vec4(vec3(rand_tent(gl_FragCoord.xy + fsp.randomness) / 256.0), 0.0);
}

float sample_channel(texture2D tex, sampler smp, vec2 uv, bool within_image)
{
    // sample unconditionally: a fetch reached only on some lanes has undefined implicit derivatives, and the
    // mip level they select feeds the trilinear minification filter
    float value = texture(sampler2D(tex, smp), uv).r;
    return within_image ? value : 0.0;
}

/// sample_channel() from the finest level alone, for a uv whose jumps, at an envmap's seams, would pick the coarsest
float sample_channel_finest(texture2D tex, sampler smp, vec2 uv, bool within_image)
{
    float value = textureLod(sampler2D(tex, smp), uv, 0.0).r;
    return within_image ? value : 0.0;
}

void main()
{
    vec2 pixel      = vec2(gl_FragCoord.x, -gl_FragCoord.y);
    vec4 background = vec4(fsp.bg_color.rgb, 1.0);
    if (fsp.bg_mode == BGMode_Black)
        background.rgb = vec3(0.0);
    else if (fsp.bg_mode == BGMode_White)
        background.rgb = vec3(1.0);
    else if (fsp.bg_mode == BGMode_Dark_Checker || fsp.bg_mode == BGMode_Light_Checker)
    {
        float dark_gray    = (fsp.bg_mode == BGMode_Dark_Checker) ? 0.1 : 0.5;
        float light_gray   = (fsp.bg_mode == BGMode_Dark_Checker) ? 0.2 : 0.55;
        float checkerboard = mod(floor(pixel.x / 8.0) + floor(pixel.y / 8.0), 2.0) == 0.0 ? dark_gray : light_gray;
        background.rgb     = sRGB_to_linear(vec3(checkerboard));
    }

    float zebra1 = (mod(float(int(floor((pixel.x + pixel.y - 30.0 * fsp.time) / 8.0))), 2.0) == 0.0) ? 0.0 : 1.0;
    float zebra2 = (mod(float(int(floor((pixel.x - pixel.y - 30.0 * fsp.time) / 8.0))), 2.0) == 0.0) ? 0.0 : 1.0;

    bool in_img = primary_uv.x < 1.0 && primary_uv.y < 1.0 && primary_uv.x > 0.0 && primary_uv.y > 0.0;
    bool in_ref = secondary_uv.x < 1.0 && secondary_uv.y < 1.0 && secondary_uv.x > 0.0 && secondary_uv.y > 0.0;

    vec4 value;
    if (fsp.remap != 0)
    {
        // A remap's preview: the quad spans the output, and each point of it reads the source where its direction
        // falls, as remapped_envmap() does; off the sphere, from the nearest point that is on it.
        vec3 dir = envmap_uv_to_xyz(fsp.remap_dst, nearest_valid_envmap_uv(fsp.remap_dst, primary_uv));
        vec2 uv  = envmap_xyz_to_uv(fsp.remap_src, dir);
        value    = vec4(sample_channel_finest(primary_0_texture, primary_0_sampler, uv, in_img),
                        sample_channel_finest(primary_1_texture, primary_1_sampler, uv, in_img),
                        sample_channel_finest(primary_2_texture, primary_2_sampler, uv, in_img),
                        sample_channel_finest(primary_3_texture, primary_3_sampler, uv, in_img));
    }
    else
        value = vec4(sample_channel(primary_0_texture, primary_0_sampler, primary_uv, in_img),
                     sample_channel(primary_1_texture, primary_1_sampler, primary_uv, in_img),
                     sample_channel(primary_2_texture, primary_2_sampler, primary_uv, in_img),
                     sample_channel(primary_3_texture, primary_3_sampler, primary_uv, in_img));

    // an edit dialog's preview, on the samples as stored, as apply_point_edit() would change them
    if (fsp.edit_op != EDIT_NONE && all(greaterThanEqual(primary_uv, fsp.edit_rect.xy)) &&
        all(lessThan(primary_uv, fsp.edit_rect.zw)))
    {
        if (fsp.edit_op < EDIT_FIRST_COLOR)
        {
            for (int k = 0; k < 4; ++k)
                if (fsp.edit_slots[k] >= 0)
                    value[k] = edit_sample(fsp.edit_op, value[k], fsp.edit_slots[k], fsp.edit_p0, fsp.edit_p1);
        }
        else if (fsp.edit_color != 0)
            value = edit_color(fsp.edit_op, value, fsp.edit_p0, fsp.edit_p1, mat3(fsp.edit_m0), mat3(fsp.edit_m1));
    }

    if (fsp.primary_luminance_chroma != 0)
        value.xyz = YC_to_RGB(value.xyz, fsp.primary_yw);

    value = fsp.primary_M_to_sRGB * value;
    value = choose_channel(value, fsp.channel, fsp.primary_straight_alpha != 0);

    if (fsp.has_reference != 0)
    {
        vec4 reference_val = vec4(sample_channel(secondary_0_texture, secondary_0_sampler, secondary_uv, in_ref),
                                  sample_channel(secondary_1_texture, secondary_1_sampler, secondary_uv, in_ref),
                                  sample_channel(secondary_2_texture, secondary_2_sampler, secondary_uv, in_ref),
                                  sample_channel(secondary_3_texture, secondary_3_sampler, secondary_uv, in_ref));

        if (fsp.secondary_luminance_chroma != 0)
            reference_val.xyz = YC_to_RGB(reference_val.xyz, fsp.secondary_yw);

        reference_val = fsp.secondary_M_to_sRGB * reference_val;
        reference_val = choose_channel(reference_val, fsp.channel, fsp.secondary_straight_alpha != 0);

        value = blend(value, reference_val, fsp.blend_mode);
    }

    vec4  foreground = expose(value, fsp.gain, fsp.offset);
    vec4  shown      = apply_tonemap(foreground);
    if (fsp.rolloff != 0)
        shown = roll_off(shown, fsp.tonemap_mode, fsp.rolloff_preserve_hue, fsp.rolloff_ceiling,
                         fsp.rolloff_has_peak != 0, fsp.rolloff_peak);
    vec4  tonemapped = shown + background * (1.0 - foreground.a);
    bvec3 clipped    = greaterThan(foreground.rgb, fsp.clip_range.yyy);
    bvec3 crushed    = lessThan(foreground.rgb, fsp.clip_range.xxx);
    vec4  blended    = linear_to_sRGB(tonemapped);
    vec4  dithered   = dither(blended);
    dithered         = clamp(dithered, fsp.clamp_to_LDR != 0 ? 0.0 : -64.0, fsp.clamp_to_LDR != 0 ? 1.0 : 64.0);
    // Stripe only where the value came from real image data: sample_channel() returns 0 outside a data
    // window, which the shadow test would read as crushed black across the whole background.
    bool in_data = in_img || (fsp.has_reference != 0 && in_ref);
    if (in_data && fsp.clip_warnings.y != 0)
        dithered.rgb = mix(dithered.rgb, vec3(zebra1), clipped);
    if (in_data && fsp.clip_warnings.x != 0)
        dithered.rgb = mix(dithered.rgb, vec3(zebra2), crushed);
    frag_color = vec4(dithered.rgb, 1.0);
}
@end

@program image_shader vs fs
