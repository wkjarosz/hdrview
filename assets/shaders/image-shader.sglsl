// Main image-view vertex+fragment shader, written once and cross-compiled to GLSL/GLES/Metal via sokol-shdc.
// See SokolShaderCompiler.cmake and CMakeLists.txt for the CMake wiring, and app-draw.cpp for how the
// compiled output is loaded and its uniforms set.
//
// GLSL uniform blocks cannot contain `bool` members (glslang rejects it), so booleans below are `int`
// (0/1); C++ call sites pass 0/1 and shader code compares with `!= 0`.

@vs vs
layout(binding=0) uniform vs_params {
    vec2 primary_scale;
    vec2 primary_pos;
    vec2 secondary_scale;
    vec2 secondary_pos;
    // Padding. With only vec2 members SPIRV-Cross's glsl300es output flattens this block to
    // `uniform vec4 vs_params[2]`, losing the member names set_buffer("vsp.*", ...) needs; one int keeps it a
    // struct, as fs_params below already is by virtue of its mixed member types.
    int _pad;
} vsp;

in vec2 position;

out vec2 primary_uv;
out vec2 secondary_uv;

void main()
{
    primary_uv   = (position / 2.0 - vsp.primary_pos + 0.5) / vsp.primary_scale;
    secondary_uv = (position / 2.0 - vsp.secondary_pos + 0.5) / vsp.secondary_scale;
    gl_Position  = vec4(position.x, -position.y, 0.0, 1.0);
}
@end

@fs fs
// constants and per-pixel math shared with C++; see src/shared/shim.h
@include ../../src/shared/shim.h
@include ../../src/shared/constants.h
@include ../../src/shared/colorspace.h
@include ../../src/shared/pipeline.h
@include ../../src/shared/edits.h
@include ../../src/shared/envmap.h

layout(binding=1) uniform fs_params {
    int   has_reference;              // whether a reference image is blended with the current one
    int   do_dither;                  // whether the output is dithered
    vec2  randomness;                 // a per-frame offset into the dither texture
    int   blend_mode;                 // how the reference is blended in, a BlendMode_
    int   channel;                    // which channels are shown, a Channels_
    float gain;                       // 2^exposure
    float offset;                     // added after the gain
    float gamma;                      // the gamma tonemap's exponent
    int   tonemap_mode;               // a Tonemap_
    int   clamp_to_LDR;               // whether the output is clamped to [0, 1]
    int   rolloff;                    // whether highlights roll off toward rolloff_ceiling
    float rolloff_preserve_hue;       // 1 rolls off the brightest channel, 0 each channel separately
    float rolloff_ceiling;            // in stops above SDR white
    int   rolloff_has_peak;           // whether rolloff_peak is known
    float rolloff_peak;               // the content's peak, in stops above SDR white
    int   bg_mode;                    // a BGMode_
    vec4  bg_color;                   // the background under BGMode_Custom_Color
    int   reverse_colormap;           // whether the colormap runs backward
    vec3  primary_yw;                 // the current image's luminance weights
    int   primary_luminance_chroma;   // whether the current image shows a luminance/chroma group
    mat4  primary_M_to_sRGB;          // from the current image's primaries to linear sRGB
    vec3  secondary_yw;               // the reference's luminance weights
    int   secondary_luminance_chroma; // whether the reference shows a luminance/chroma group
    mat4  secondary_M_to_sRGB;        // from the reference's primaries to linear sRGB
    float time;                       // in seconds, which moves the clip warnings' stripes
    ivec2 clip_warnings;              // whether crushed (x) and clipped (y) values are striped
    vec2  clip_range;                 // the values below and above which they count as crushed and clipped
    int   primary_straight_alpha;     // whether the current image's alpha is straight
    int   secondary_straight_alpha;   // whether the reference's alpha is straight
    int   primary_levels;             // the mip levels the current image's textures have
    // an edit dialog's preview of the current image: see EditPreview and shader_edit() in src/edit/preview.h, and
    // src/shared/edits.h for the slots each op reads
    int   edit_op;                    // an EDIT_ op, or EDIT_NONE
    ivec4 edit_slots;                 // which of the subject's channels each slot shows, or -1 for none
    int   edit_color;                 // whether a color op reaches the shown group
    vec4  edit_rect;                  // the subject's rectangle in uv: min, then max
    vec4  edit_p0;                    // the op's first vector of parameters
    vec4  edit_p1;                    // the op's second vector of parameters
    mat4  edit_m0;                    // the op's first matrix parameter
    mat4  edit_m1;                    // the op's second matrix parameter
    ivec4 edit_i0;                    // the op's integer parameters, for an op reading more than a pixel
} fsp;

layout(binding=0) uniform texture2D colormap;
layout(binding=0) uniform sampler   colormap_sampler;

layout(binding=1) uniform texture2D dither_texture;
layout(binding=1) uniform sampler   dither_sampler;

layout(binding=2) uniform texture2D primary_0_texture;
layout(binding=3) uniform texture2D primary_1_texture;
layout(binding=4) uniform texture2D primary_2_texture;
layout(binding=5) uniform texture2D primary_3_texture;
layout(binding=2) uniform sampler   primary_0_sampler;
layout(binding=3) uniform sampler   primary_1_sampler;
layout(binding=4) uniform sampler   primary_2_sampler;
layout(binding=5) uniform sampler   primary_3_sampler;

layout(binding=6) uniform texture2D secondary_0_texture;
layout(binding=7) uniform texture2D secondary_1_texture;
layout(binding=8) uniform texture2D secondary_2_texture;
layout(binding=9) uniform texture2D secondary_3_texture;
layout(binding=6) uniform sampler   secondary_0_sampler;
layout(binding=7) uniform sampler   secondary_1_sampler;
layout(binding=8) uniform sampler   secondary_2_sampler;
layout(binding=9) uniform sampler   secondary_3_sampler;

in vec2 primary_uv;
in vec2 secondary_uv;

out vec4 frag_color;

// The tonemap step with the colormap read from its texture; the rest is tonemap() in src/shared/pipeline.h.
vec4 apply_tonemap(vec4 color)
{
    vec3 colormap_sRGB = vec3(0.0);
    if (fsp.tonemap_mode != Tonemap_Gamma)
    {
        // texel centers, so that 0 and 1 land on the colormap's first and last colors
        float n = float(textureSize(sampler2D(colormap, colormap_sampler), 0).x);
        float t = mix(0.5 / n, (n - 0.5) / n, colormap_coordinate(color.rgb, fsp.tonemap_mode, fsp.reverse_colormap != 0));
        colormap_sRGB = texture(sampler2D(colormap, colormap_sampler), vec2(t, 0.5)).rgb;
    }
    return tonemap(color, fsp.tonemap_mode, fsp.gamma, colormap_sRGB);
}

float rand_box(vec2 xy)
{
    // Result is in range (-0.5, 0.5)
    return (texture(sampler2D(dither_texture, dither_sampler), xy / vec2(256, 256)).r + 0.5) / 65536.0 - 0.5;
}

float rand_tent(vec2 xy)
{
    float r = rand_box(xy);

    // Convert uniform distribution into triangle-shaped distribution
    // Result is in range (-0.5,0.5)
    float rp = sqrt(2.0 * r);             // positive triangle
    float rn = sqrt(2.0 * r + 1.0) - 1.0; // negative triangle
    return (r < 0.0) ? 0.5 * rn : 0.5 * rp;
}

vec4 dither(vec4 color)
{
    if (fsp.do_dither == 0)
        return color;

    return color + vec4(vec3(rand_tent(gl_FragCoord.xy + fsp.randomness) / 256.0), 0.0);
}

float sample_channel(texture2D tex, sampler smp, vec2 uv, bool within_image)
{
    // sample unconditionally: a fetch reached only on some lanes has undefined implicit derivatives, and the
    // mip level they select feeds the trilinear minification filter
    float value = texture(sampler2D(tex, smp), uv).r;
    return within_image ? value : 0.0;
}

/// Texel \p p of \p tex at \p level; a slot showing no channel is a single texel, read wherever \p p is.
float fetch_channel(texture2D tex, sampler smp, ivec2 p, int level)
{
    // one fetch whichever it is: every read the previews make inlines this, many times over
    ivec2 n   = textureSize(sampler2D(tex, smp), 0);
    bool  one = n.x == 1 && n.y == 1;
    return texelFetch(sampler2D(tex, smp), one ? ivec2(0) : p, one ? 0 : level).r;
}

/// Texel \p p of the four shown channels at \p level.
vec4 fetch_shown(ivec2 p, int level)
{
    return vec4(fetch_channel(primary_0_texture, primary_0_sampler, p, level),
                fetch_channel(primary_1_texture, primary_1_sampler, p, level),
                fetch_channel(primary_2_texture, primary_2_sampler, p, level),
                fetch_channel(primary_3_texture, primary_3_sampler, p, level));
}

/// The image's size: the largest of the four slots', since a slot showing no channel is one texel.
ivec2 shown_size()
{
    return max(max(textureSize(sampler2D(primary_0_texture, primary_0_sampler), 0),
                   textureSize(sampler2D(primary_1_texture, primary_1_sampler), 0)),
               max(textureSize(sampler2D(primary_2_texture, primary_2_sampler), 0),
                   textureSize(sampler2D(primary_3_texture, primary_3_sampler), 0)));
}

// What src/shared/envmap_sample.h reads here: the four shown channels at once, from the textures' mipmaps.
#define EnvValue vec4
struct EnvSource
{
    int   mapping;
    int   levels;
    float ratio;
    float spread;
    ivec2 size;
};
vec4 envmap_fetch(EnvSource src, int level, int chart, ivec2 size, ivec2 p)
{
    // a cube layout's faces are cells of the one image
    return fetch_shown(envmap_is_cube(src.mapping) ? envmap_face_texel_in_image(src.mapping, chart, p, size.x) : p,
                       level);
}

@include ../../src/shared/envmap_sample.h

// What src/shared/resample.h reads here: the four shown channels at once, from the textures' finest level.
#define ResampleValue vec4
struct ResampleSource
{
    ivec2 size;
};
vec4 resample_fetch(ResampleSource src, ivec2 p) { return fetch_shown(p, 0); }

@include ../../src/shared/resample.h

/// The current image's samples \p value at \p uv, changed as the open edit dialog previews them.
/**
    A remap or an irradiance map fills the output's quad, each output pixel taking the color remapped_envmap() (through
    envmap_sample.h) or irradiance_envmap() gives it. Within the subject's rectangle, a shift reads through resample.h
    as shifted() does, a bump map takes bump_normal() of heights read through resample.h's border modes, and a
    point-wise edit maps the stored samples as apply_point_edit() does.
*/
vec4 edit_preview(vec4 value, vec2 uv, bool in_img)
{
    if (!in_img)
        return value;

    if (fsp.edit_op == EDIT_IRRADIANCE)
    {
        // the output pixel uv falls in, at whose center the irradiance is weighed, as irradiance_envmap() weighs it
        ivec2 size    = ivec2(fsp.edit_p1.xy);
        int   mapping = fsp.edit_i0.x;
        ivec2 pixel   = clamp(ivec2(floor(uv * vec2(size))), ivec2(0), size - 1);
        mat3  w       = envmap_irradiance_weights(envmap_uv_to_xyz(mapping, (vec2(pixel) + 0.5) / vec2(size)));
        // each coefficient across the four slots: the first four are edit_m0's columns, the next four edit_m1's
        vec4 irradiance = w[0][0] * fsp.edit_m0[0] + w[0][1] * fsp.edit_m0[1] + w[0][2] * fsp.edit_m0[2] +
                          w[1][0] * fsp.edit_m0[3] + w[1][1] * fsp.edit_m1[0] + w[1][2] * fsp.edit_m1[1] +
                          w[2][0] * fsp.edit_m1[2] + w[2][1] * fsp.edit_m1[3] + w[2][2] * fsp.edit_p0;
        // a slot showing no channel keeps what it shows, an opaque alpha for an image without one
        bvec4 shown = notEqual(ivec4(fsp.edit_i0.y) & ivec4(1, 2, 4, 8), ivec4(0));
        return mix(value, irradiance, shown);
    }

    if (fsp.edit_op == EDIT_REMAP)
    {
        // the output pixel uv falls in, so each shows as one color
        ivec2 size     = ivec2(fsp.edit_p0.xy);
        mat3  R        = mat3(fsp.edit_m0);
        int   src_map  = fsp.edit_i0.x;
        int   dst_map  = fsp.edit_i0.y;
        int   sampling = fsp.edit_i0.z;
        int   quality  = fsp.edit_i0.w;
        float spread   = fsp.edit_p0.z; // envmap_gaussian_scale() of the supersampling set
        ivec2 pixel    = clamp(ivec2(floor(uv * vec2(size))), ivec2(0), size - 1);

        // the textures' mipmaps average 2x2 blocks, halving each level and blurring by a quarter of a squared texel
        EnvSource src = EnvSource(src_map, fsp.primary_levels, 2.0, 0.25, shown_size());
        // a level of the whole image's mipmaps holds whole texels of each face only while it halves the face size
        // exactly, so as many levels as the face size has trailing zero bits, after the finest
        if (envmap_is_cube(src.mapping))
        {
            int n      = envmap_face_size(src.mapping, src.size);
            src.levels = min(src.levels, int(log2(float(n & -n))) + 1);
        }

        return sampling == ENVMAP_SAMPLE_EWA ? envmap_ewa(src, dst_map, R, pixel, size, quality)
                                             : envmap_supersample(src, dst_map, R, pixel, size, quality, spread);
    }

    if (!all(greaterThanEqual(uv, fsp.edit_rect.xy)) || !all(lessThan(uv, fsp.edit_rect.zw)))
        return value;

    if (fsp.edit_op == EDIT_SHIFT)
    {
        vec2           offset  = fsp.edit_p0.xy;
        int            interp  = fsp.edit_i0.x;
        ivec2          borders = fsp.edit_i0.yz;
        ResampleSource src     = ResampleSource(shown_size());
        vec4           shifted = resample_shifted(src, ivec2(floor(uv * vec2(src.size))), offset, interp, borders.x,
                                                  borders.y);
        return mix(value, shifted, greaterThanEqual(fsp.edit_slots, ivec4(0)));
    }

    if (fsp.edit_op == EDIT_BUMP_NORMAL)
    {
        if (fsp.edit_color == 0)
            return value;
        // a color group's first three channels make the height; its alpha says nothing about it
        vec2           scale   = fsp.edit_p0.xy;
        ivec2          borders = fsp.edit_i0.xy;
        ResampleSource src     = ResampleSource(shown_size());
        ivec2          p       = ivec2(floor(uv * vec2(src.size)));
        float          h       = dot(resample_bordered(src, p.x, p.y, borders.x, borders.y).xyz, vec3(1.0 / 3.0));
        float          across  = dot(resample_bordered(src, p.x + 1, p.y, borders.x, borders.y).xyz, vec3(1.0 / 3.0));
        float          down    = dot(resample_bordered(src, p.x, p.y + 1, borders.x, borders.y).xyz, vec3(1.0 / 3.0));
        return vec4(bump_normal(h, across, down, scale), 1.0);
    }

    if (fsp.edit_op == EDIT_NONE)
        return value;
    if (fsp.edit_op >= EDIT_FIRST_COLOR)
        return fsp.edit_color != 0
                   ? edit_color(fsp.edit_op, value, fsp.edit_p0, fsp.edit_p1, mat3(fsp.edit_m0), mat3(fsp.edit_m1))
                   : value;
    vec4 edited = value;
    for (int k = 0; k < 4; ++k)
        if (fsp.edit_slots[k] >= 0)
            edited[k] = edit_sample(fsp.edit_op, value[k], fsp.edit_slots[k], fsp.edit_p0, fsp.edit_p1);
    return edited;
}

void main()
{
    vec2 pixel      = vec2(gl_FragCoord.x, -gl_FragCoord.y);
    vec4 background = vec4(fsp.bg_color.rgb, 1.0);
    if (fsp.bg_mode == BGMode_Black)
        background.rgb = vec3(0.0);
    else if (fsp.bg_mode == BGMode_White)
        background.rgb = vec3(1.0);
    else if (fsp.bg_mode == BGMode_Dark_Checker || fsp.bg_mode == BGMode_Light_Checker)
    {
        float dark_gray    = (fsp.bg_mode == BGMode_Dark_Checker) ? 0.1 : 0.5;
        float light_gray   = (fsp.bg_mode == BGMode_Dark_Checker) ? 0.2 : 0.55;
        float checkerboard = mod(floor(pixel.x / 8.0) + floor(pixel.y / 8.0), 2.0) == 0.0 ? dark_gray : light_gray;
        background.rgb     = sRGB_to_linear(vec3(checkerboard));
    }

    float zebra1 = (mod(float(int(floor((pixel.x + pixel.y - 30.0 * fsp.time) / 8.0))), 2.0) == 0.0) ? 0.0 : 1.0;
    float zebra2 = (mod(float(int(floor((pixel.x - pixel.y - 30.0 * fsp.time) / 8.0))), 2.0) == 0.0) ? 0.0 : 1.0;

    bool in_img = primary_uv.x < 1.0 && primary_uv.y < 1.0 && primary_uv.x > 0.0 && primary_uv.y > 0.0;
    bool in_ref = secondary_uv.x < 1.0 && secondary_uv.y < 1.0 && secondary_uv.x > 0.0 && secondary_uv.y > 0.0;

    vec4 value = vec4(
        sample_channel(primary_0_texture, primary_0_sampler, primary_uv, in_img),
        sample_channel(primary_1_texture, primary_1_sampler, primary_uv, in_img),
        sample_channel(primary_2_texture, primary_2_sampler, primary_uv, in_img),
        sample_channel(primary_3_texture, primary_3_sampler, primary_uv, in_img));
    value = edit_preview(value, primary_uv, in_img);

    if (fsp.primary_luminance_chroma != 0)
        value.xyz = YC_to_RGB(value.xyz, fsp.primary_yw);

    value = fsp.primary_M_to_sRGB * value;
    value = choose_channel(value, fsp.channel, fsp.primary_straight_alpha != 0);

    if (fsp.has_reference != 0)
    {
        vec4 reference_val = vec4(sample_channel(secondary_0_texture, secondary_0_sampler, secondary_uv, in_ref),
                                  sample_channel(secondary_1_texture, secondary_1_sampler, secondary_uv, in_ref),
                                  sample_channel(secondary_2_texture, secondary_2_sampler, secondary_uv, in_ref),
                                  sample_channel(secondary_3_texture, secondary_3_sampler, secondary_uv, in_ref));

        if (fsp.secondary_luminance_chroma != 0)
            reference_val.xyz = YC_to_RGB(reference_val.xyz, fsp.secondary_yw);

        reference_val = fsp.secondary_M_to_sRGB * reference_val;
        reference_val = choose_channel(reference_val, fsp.channel, fsp.secondary_straight_alpha != 0);

        value = blend(value, reference_val, fsp.blend_mode);
    }

    vec4  foreground = expose(value, fsp.gain, fsp.offset);
    vec4  shown      = apply_tonemap(foreground);
    if (fsp.rolloff != 0)
        shown = roll_off(shown, fsp.tonemap_mode, fsp.rolloff_preserve_hue, fsp.rolloff_ceiling,
                         fsp.rolloff_has_peak != 0, fsp.rolloff_peak);
    vec4  tonemapped = shown + background * (1.0 - foreground.a);
    bvec3 clipped    = greaterThan(foreground.rgb, fsp.clip_range.yyy);
    bvec3 crushed    = lessThan(foreground.rgb, fsp.clip_range.xxx);
    vec4  blended    = linear_to_sRGB(tonemapped);
    vec4  dithered   = dither(blended);
    dithered         = clamp(dithered, fsp.clamp_to_LDR != 0 ? 0.0 : -64.0, fsp.clamp_to_LDR != 0 ? 1.0 : 64.0);
    // Stripe only where the value came from real image data: sample_channel() returns 0 outside a data
    // window, which the shadow test would read as crushed black across the whole background.
    bool in_data = in_img || (fsp.has_reference != 0 && in_ref);
    if (in_data && fsp.clip_warnings.y != 0)
        dithered.rgb = mix(dithered.rgb, vec3(zebra1), clipped);
    if (in_data && fsp.clip_warnings.x != 0)
        dithered.rgb = mix(dithered.rgb, vec3(zebra2), crushed);
    frag_color = vec4(dithered.rgb, 1.0);
}
@end

@program image_shader vs fs
